class UpdateReport {


    constructor(){


        this.success = false;

        this.startedAt = new Date();

        this.finishedAt = null;

        this.duration = 0;



        this.version = null;



        this.filesCopied = [];

        this.filesDeleted = [];

        this.filesRenamed = [];

        this.filesMoved = [];



        this.warnings = [];

        this.errors = [];



        this.rollbackExecuted = false;

        this.rollbackSucceeded = false;


    }





    addCopied(file){

        this.filesCopied.push(file);

    }



    addDeleted(file){

        this.filesDeleted.push(file);

    }



    addRenamed(from,to){

        this.filesRenamed.push({

            from,

            to

        });

    }



    addMoved(from,to){

        this.filesMoved.push({

            from,

            to

        });

    }



    warning(message){

        this.warnings.push(message);

    }



    error(message){

        this.errors.push(message);

    }





    finish(success){


        this.success = success;

        this.finishedAt = new Date();

        this.duration =

            this.finishedAt - this.startedAt;


    }





    toJSON(){


        return{

            success:this.success,

            version:this.version,

            startedAt:this.startedAt,

            finishedAt:this.finishedAt,

            duration:this.duration,

            filesCopied:this.filesCopied,

            filesDeleted:this.filesDeleted,

            filesRenamed:this.filesRenamed,

            filesMoved:this.filesMoved,

            warnings:this.warnings,

            errors:this.errors,

            rollbackExecuted:this.rollbackExecuted,

            rollbackSucceeded:this.rollbackSucceeded

        };


    }


}


module.exports = UpdateReport;